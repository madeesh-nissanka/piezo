{
  "_header": "Piezo v0.3.0 - MIT License - Copyright (c) Madeesh P. Nissanka",
  "name": "generic_cli",
  "executable": "echo",
  "args_template": ["{input}"],
  "allowed_executables": ["echo", "cat", "ls", "python3", "bash", "sh", "node", "perl", "ruby"],
  "patterns": [
    {"name": "error", "regex": "Error|ERROR|FAIL|fail|Exception", "type": "error"},
    {"name": "warning", "regex": "Warning|WARNING|warn|WARN", "type": "warning"},
    {"name": "progress", "regex": "step\\s+(?<step>\\d+)\\s+residual\\s+(?<residual>[0-9.eE+\\-]+)", "fields": ["step", "residual"], "type": "progress"},
    {"name": "converged", "regex": "Converged|converged|Done|Finished|SUCCESS|Complete|convergence achieved|solution converged", "type": "converged"},
    {"name": "diverged", "regex": "diverged|Diverged|DIVERGED|divergence detected|not converged|failed to converge", "type": "diverged"},
    {"name": "percent", "regex": "\\[(?<percent>\\d+)%\\]", "fields": ["percent"], "type": "progress"},
    {"name": "progress_pct", "regex": "progress\\s*[:=]?\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_alt", "regex": "progress\\s*[:=]\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)\\s*%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "iteration_residual", "regex": "(?:iteration|iter)\\s+(?<iteration>\\d+)\\s+(?:residual|norm|normInf)\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)", "flags": "i", "type": "iteration", "fields": ["iteration", "residual"]},
    {"name": "iteration_simple", "regex": "iteration\\s+(?<iteration>\\d+)", "flags": "i", "type": "iteration", "fields": ["iteration"]},
    {"name": "eta", "regex": "(?:eta|remaining time)\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s", "flags": "i", "type": "info", "fields": ["eta_s"]},
    {"name": "eta_hms", "regex": "eta\\s*[:=]?\\s*(?<eta_s>\\d+:\\d+:\\d+)", "flags": "i", "type": "info", "fields": ["eta_s"]}
  ],
  "metadata": {"category": "generic", "description": "Generic CLI adapter with extended patterns for any command-line tool"}
}