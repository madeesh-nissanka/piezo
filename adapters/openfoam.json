{
  "_header": "Piezo v0.3.0 - MIT License - Copyright (c) Madeesh P. Nissanka",
  "name": "openfoam",
  "executable": "simpleFoam",
  "args_template": ["-case", "{input}"],
  "allowed_executables": ["simpleFoam", "pimpleFoam", "icoFoam", "rhoSimpleFoam", "pisoFoam", "foamRun"],
  "patterns": [
    {"name": "error", "regex": "Error|ERROR|Fatal|FOAM FATAL", "type": "error"},
    {"name": "warning", "regex": "Warning|WARNING", "type": "warning"},
    {"name": "converged", "regex": "End|converged|SUCCESS|ExecutionTime|convergence achieved|solution converged", "type": "converged"},
    {"name": "diverged", "regex": "diverged|Diverged|DIVERGED|divergence detected|not converged|failed to converge", "type": "diverged"},
    {"name": "timeStep", "regex": "Time\\s*=\\s*(?<timeStep>[0-9.eE+\\-]+)", "fields": ["timeStep"], "type": "progress"},
    {"name": "residual", "regex": "(?<solver>\\w+)\\s+Initial\\s+residual\\s*=\\s*(?<residual>[0-9.eE+\\-]+)", "fields": ["solver", "residual"], "type": "progress"},
    {"name": "continuity", "regex": "continuity\\s+errors\\s*=\\s*(?<error>[0-9.eE+\\-]+)", "fields": ["error"], "type": "progress"},
    {"name": "progress_pct", "regex": "progress\\s*[:=]?\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_alt", "regex": "progress\\s*[:=]\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)\\s*%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_bracket", "regex": "\\[(?<progress_pct>\\d+(?:\\.\\d+)?)%\\]", "type": "progress", "fields": ["progress_pct"]},
    {"name": "iteration_residual", "regex": "(?:iteration|iter)\\s+(?<iteration>\\d+)\\s+(?:residual|norm|normInf)\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)", "flags": "i", "type": "iteration", "fields": ["iteration", "residual"]},
    {"name": "iteration_simple", "regex": "iteration\\s+(?<iteration>\\d+)", "flags": "i", "type": "iteration", "fields": ["iteration"]},
    {"name": "eta", "regex": "(?:eta|remaining time)\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s", "flags": "i", "type": "info", "fields": ["eta_s"]},
    {"name": "eta_hms", "regex": "eta\\s*[:=]?\\s*(?<eta_s>\\d+:\\d+:\\d+)", "flags": "i", "type": "info", "fields": ["eta_s"]}
  ],
  "metadata": {"category": "cfd", "solver": "OpenFOAM", "description": "OpenFOAM CFD solver suite"}
}