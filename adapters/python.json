{
  "_header": "Piezo v0.3.0 - MIT License - Copyright (c) Madeesh P. Nissanka",
  "name": "python",
  "executable": "python3",
  "args_template": ["{input}"],
  "allowed_executables": ["python3", "python"],
  "version_probe": ["--version"],
  "timeout_s": 3600,
  "patterns": [
    {"name": "progress", "regex": "step\\s+(?<step>\\d+)\\s+residual\\s+(?<residual>[0-9.eE+\\-]+)", "type": "progress", "fields": ["step", "residual"]},
    {"name": "progress_pct", "regex": "progress\\s*[:=]?\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_alt", "regex": "progress\\s*[:=]\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)\\s*%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_bracket", "regex": "\\[(?<progress_pct>\\d+(?:\\.\\d+)?)%\\]", "type": "progress", "fields": ["progress_pct"]},
    {"name": "iteration_residual", "regex": "(?:iteration|iter)\\s+(?<iteration>\\d+)\\s+(?:residual|norm|normInf)\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)", "flags": "i", "type": "iteration", "fields": ["iteration", "residual"]},
    {"name": "iteration_simple", "regex": "iteration\\s+(?<iteration>\\d+)", "flags": "i", "type": "iteration", "fields": ["iteration"]},
    {"name": "warning", "regex": "WARNING|Warning|warning", "type": "warning", "severity": "warn"},
    {"name": "error", "regex": "ERROR|Error|error|Traceback|Exception|FATAL|Segmentation fault", "type": "error", "severity": "error"},
    {"name": "converged", "regex": "Converged|converged|CONVERGED|convergence achieved|solution converged", "type": "converged"},
    {"name": "diverged", "regex": "Diverged|diverged|DIVERGED|divergence detected|not converged|failed to converge|NaN|nan", "type": "diverged"},
    {"name": "elapsed", "regex": "elapsed\\s*[:=]?\\s*(?<elapsed_s>\\d+(?:\\.\\d+)?)\\s*s", "type": "info", "fields": ["elapsed_s"]},
    {"name": "eta", "regex": "ETA\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s", "type": "info", "fields": ["eta_s"]},
    {"name": "eta_generic", "regex": "(?:eta|remaining time)\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s", "flags": "i", "type": "info", "fields": ["eta_s"]},
    {"name": "eta_hms", "regex": "eta\\s*[:=]?\\s*(?<eta_s>\\d+:\\d+:\\d+)", "flags": "i", "type": "info", "fields": ["eta_s"]}
  ]
}