{
  "_header": "Piezo v0.3.0 - MIT License - Copyright (c) Madeesh P. Nissanka",
  "name": "calculix",
  "executable": "ccx",
  "args_template": ["-i", "{input}"],
  "allowed_executables": ["ccx", "ccx_2.21", "ccx_2.20", "ccx_2.19"],
  "version_probe": ["-v"],
  "timeout_s": 7200,
  "patterns": [
    {"name": "increment", "regex": "Increment\\s+(?<increment>\\d+)", "type": "iteration", "fields": ["increment"]},
    {"name": "attempt", "regex": "Attempt\\s+(?<attempt>\\d+)", "type": "iteration", "fields": ["attempt"]},
    {"name": "iteration_residual", "regex": "(?:iteration|iter)\\s+(?<iteration>\\d+)\\s+(?:residual|norm|normInf)\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)", "type": "iteration", "fields": ["iteration", "residual"], "flags": "i"},
    {"name": "iteration_simple", "regex": "iteration\\s+(?<iteration>\\d+)", "type": "iteration", "fields": ["iteration"], "flags": "i"},
    {"name": "progress", "regex": "progress\\s*[:=]?\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_alt", "regex": "progress\\s*[:=]\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)\\s*%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_bracket", "regex": "\\[(?<progress_pct>\\d+(?:\\.\\d+)?)%\\]", "type": "progress", "fields": ["progress_pct"]},
    {"name": "residual", "regex": "residual\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)", "type": "progress", "fields": ["residual"]},
    {"name": "warning", "regex": "WARNING|Warning|warning|\\*WARNING", "type": "warning", "severity": "warn"},
    {"name": "error", "regex": "\\*ERROR|ERROR|Error|error|Segmentation fault|FATAL", "type": "error", "severity": "error"},
    {"name": "converged", "regex": "Job finished|converged|Converged|CONVERGED|solution converged|convergence achieved", "type": "converged"},
    {"name": "diverged", "regex": "diverged|Diverged|DIVERGED|divergence detected|not converged|failed to converge|DIVERGENCE", "type": "diverged"},
    {"name": "elapsed", "regex": "Total time\\s*[:=]?\\s*(?<elapsed_s>\\d+(?:\\.\\d+)?)", "type": "info", "fields": ["elapsed_s"]},
    {"name": "eta", "regex": "(?:eta|remaining time)\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s", "type": "info", "fields": ["eta_s"], "flags": "i"},
    {"name": "eta_hms", "regex": "eta\\s*[:=]?\\s*(?<eta_s>\\d+:\\d+:\\d+)", "type": "info", "fields": ["eta_s"], "flags": "i"}
  ]
}