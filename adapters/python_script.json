{
  "_header": "Piezo v0.3.0 - MIT License - Copyright (c) Madeesh P. Nissanka",
  "name": "python_script",
  "executable": "python3",
  "args_template": ["{input}"],
  "allowed_executables": ["python3", "python"],
  "patterns": [
    {
      "name": "progress",
      "regex": "step\\s+(?<step>\\d+)\\s+residual\\s+(?<residual>[0-9.eE+\\-]+)",
      "fields": ["step", "residual"],
      "type": "progress"
    },
    {
      "name": "warning",
      "regex": "warning",
      "flags": "i",
      "type": "warning"
    },
    {
      "name": "error",
      "regex": "Traceback|Error|ERROR|Exception|Failed",
      "type": "error"
    },
    {
      "name": "converged",
      "regex": "Converged|converged|Done|Finished|SUCCESS|complete|convergence achieved|solution converged",
      "type": "converged"
    },
    {
      "name": "diverged",
      "regex": "diverged|Diverged|DIVERGED|divergence detected|not converged|failed to converge",
      "type": "diverged"
    },
    {
      "name": "iteration",
      "regex": "Iteration\\s+(?<iter>\\d+)\\s+.*?residual\\s*(?<residual>[0-9.eE+\\-]+)",
      "fields": ["iter", "residual"],
      "type": "iteration"
    },
    {
      "name": "iteration_residual",
      "regex": "(?:iteration|iter)\\s+(?<iteration>\\d+)\\s+(?:residual|norm|normInf)\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)",
      "flags": "i",
      "type": "iteration",
      "fields": ["iteration", "residual"]
    },
    {
      "name": "iteration_simple",
      "regex": "iteration\\s+(?<iteration>\\d+)",
      "flags": "i",
      "type": "iteration",
      "fields": ["iteration"]
    },
    {
      "name": "progress_pct",
      "regex": "progress\\s*[:=]?\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)%",
      "type": "progress",
      "fields": ["progress_pct"]
    },
    {
      "name": "progress_alt",
      "regex": "progress\\s*[:=]\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)\\s*%",
      "type": "progress",
      "fields": ["progress_pct"]
    },
    {
      "name": "progress_bracket",
      "regex": "\\[(?<progress_pct>\\d+(?:\\.\\d+)?)%\\]",
      "type": "progress",
      "fields": ["progress_pct"]
    },
    {
      "name": "eta",
      "regex": "(?:eta|remaining time)\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s",
      "flags": "i",
      "type": "info",
      "fields": ["eta_s"]
    },
    {
      "name": "eta_hms",
      "regex": "eta\\s*[:=]?\\s*(?<eta_s>\\d+:\\d+:\\d+)",
      "flags": "i",
      "type": "info",
      "fields": ["eta_s"]
    }
  ],
  "metadata": {"category": "script", "language": "python", "description": "Python script adapter with extended patterns"}
}