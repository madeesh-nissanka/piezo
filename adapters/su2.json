{
  "_header": "Piezo v0.3.0 - MIT License - Copyright (c) Madeesh P. Nissanka",
  "name": "su2",
  "executable": "SU2_CFD",
  "args_template": ["{input}"],
  "allowed_executables": ["SU2_CFD", "SU2_SOL", "SU2_DEF", "SU2_DOT"],
  "patterns": [
    {"name": "error", "regex": "Error|ERROR|FAIL", "type": "error"},
    {"name": "warning", "regex": "Warning|WARNING", "type": "warning"},
    {"name": "converged", "regex": "converged|Converged|SUCCESS|End of calculation|convergence achieved|solution converged", "type": "converged"},
    {"name": "diverged", "regex": "diverged|Diverged|DIVERGED|divergence detected|not converged|failed to converge", "type": "diverged"},
    {"name": "iteration", "regex": "Iteration\\s+(?<iteration>\\d+)", "fields": ["iteration"], "type": "progress"},
    {"name": "iteration_residual", "regex": "(?:iteration|iter)\\s+(?<iteration>\\d+)\\s+(?:residual|norm|rms|normInf)\\s*[:=]?\\s*(?<residual>[0-9.eE+\\-]+)", "flags": "i", "type": "iteration", "fields": ["iteration", "residual"]},
    {"name": "iteration_simple", "regex": "iteration\\s+(?<iteration>\\d+)", "flags": "i", "type": "iteration", "fields": ["iteration"]},
    {"name": "residual", "regex": "RMS\\s+\\[Density\\]\\s*=\\s*(?<residual>[0-9.eE+\\-]+)", "fields": ["residual"], "type": "progress"},
    {"name": "lift", "regex": "CL\\s*=\\s*(?<cl>[0-9.eE+\\-]+)", "fields": ["cl"], "type": "progress"},
    {"name": "drag", "regex": "CD\\s*=\\s*(?<cd>[0-9.eE+\\-]+)", "fields": ["cd"], "type": "progress"},
    {"name": "progress_pct", "regex": "progress\\s*[:=]?\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_alt", "regex": "progress\\s*[:=]\\s*(?<progress_pct>\\d+(?:\\.\\d+)?)\\s*%", "type": "progress", "fields": ["progress_pct"]},
    {"name": "progress_bracket", "regex": "\\[(?<progress_pct>\\d+(?:\\.\\d+)?)%\\]", "type": "progress", "fields": ["progress_pct"]},
    {"name": "eta", "regex": "(?:eta|remaining time)\\s*[:=]?\\s*(?<eta_s>\\d+(?:\\.\\d+)?)\\s*s", "flags": "i", "type": "info", "fields": ["eta_s"]},
    {"name": "eta_hms", "regex": "eta\\s*[:=]?\\s*(?<eta_s>\\d+:\\d+:\\d+)", "flags": "i", "type": "info", "fields": ["eta_s"]}
  ],
  "metadata": {"category": "cfd", "solver": "SU2", "description": "SU2 CFD solver"}
}